# URL pública do site, SEM barra final. Dela derivam canonical, Open Graph
# (og:image sai absoluta), sitemap e robots.
#
# Enquanto não há domínio próprio, use a URL do projeto na Vercel:
#   NEXT_PUBLIC_SITE_URL=https://landing-isabela-sixel.vercel.app
#
# Configure nas Environment Variables da Vercel (Production e Preview).
# Se ficar em branco em produção, cai para VERCEL_PROJECT_PRODUCTION_URL;
# em dev/build local, para http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
